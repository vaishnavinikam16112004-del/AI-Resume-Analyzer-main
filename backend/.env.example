# Server Configuration
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas cluster or local mongodb://127.0.0.1:27017/ai_resume_analyzer)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ai_resume_analyzer?retryWrites=true&w=majority

# JWT Secret for authentication tokens (any long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# OpenAI API Configuration (Optional: fallback analyzer is used if empty or USE_AI is false)
USE_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend URL for CORS (e.g. http://localhost:5173 for local, or your Render frontend URL for production)
CLIENT_URL=http://localhost:5173
